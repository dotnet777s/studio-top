# Copie este arquivo para .env (o iniciar.bat faz isso sozinho) e preencha.
# O .env NUNCA vai para o GitHub.

# --- IA (obrigatório) — chave do Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: ordem dos modelos (o primeiro é o principal, os outros são reserva)
# GEMINI_MODELOS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# --- Banco do estoque na nuvem (outros apps consultam o estoque e as fotos daqui)
# Postgres do Neon ou Supabase. Ex.: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/estoque?sslmode=require
# Atenção: só UMA máquina (a da empresa) deve ter esta linha preenchida — é ela que manda os dados.
ESTOQUE_DATABASE_URL=
# Fotos de carros vendidos há mais de N dias saem da nuvem (continuam no computador). Padrão: 30
# ESTOQUE_FOTOS_VENDIDOS_DIAS=30

# --- Opcional: fotos num storage S3 com link público (Supabase Storage, Cloudflare R2…).
# Sem isto, as fotos ficam dentro do próprio banco (tabela veiculo_foto_arquivo).
# FOTOS_S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
# FOTOS_S3_BUCKET=fotos-carros
# FOTOS_S3_CHAVE=
# FOTOS_S3_SEGREDO=
# FOTOS_S3_REGIAO=sa-east-1
# FOTOS_URL_PUBLICA=https://xxxx.supabase.co/storage/v1/object/public/fotos-carros

# --- TopCRM (só enquanto ele existir; depois apague)
# TOPCRM_DATABASE_URL=

# --- API local de estoque (/api/publico/estoque): exige este token se preenchido
# API_ESTOQUE_TOKEN=

# --- Servidor: por padrão só este computador acessa (127.0.0.1). Para abrir na rede da loja use HOST=0.0.0.0
# HOST=127.0.0.1
# PORTA=5000
